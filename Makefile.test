# Testing Makefile - static checks + ministack (Podman) sandbox. NO real AWS, no cost.
# Implements the vendored container-sandbox skill (.claude/skills/container-sandbox).
# How local testing works end-to-end is documented in tests/README.md.
#
#   make -f Makefile.test test                 # fmt-check + validate + helm-lint (Podman)
#   make -f Makefile.test ministack            # full plan vs mock AWS (Podman)
#   make -f Makefile.test ministack-down       # clean up leftover containers

ENV   ?= dev
TFDIR := terraform/envs/$(ENV)

# helm runs inside a container - no local helm install needed.
HELM_IMAGE := docker.io/alpine/helm:latest
HELM       := podman run --rm -v $(CURDIR)/helm:/apps:Z -w /apps $(HELM_IMAGE)

.DEFAULT_GOAL := test

# Node runs inside Podman - nothing is installed on the host.
# The repo ROOT is mounted, not drill/, because the grader's conformance tests read
# scenarios/answers/ and tests/fixtures/ which live above drill/.
# node_modules is a NAMED PODMAN VOLUME rather than a directory in the mounted repo,
# so the dependency tree never lands on the host filesystem at all. Only an empty
# mountpoint does. Drop it with `make -f Makefile.test drill-clean`.
NODE_IMAGE  := docker.io/node:22-alpine
NODE_MODULES := daily-eks-practice-drill-node-modules
NODE        := podman run --rm --userns=keep-id \
                 -v $(CURDIR):/repo:Z \
                 -v $(NODE_MODULES):/repo/drill/node_modules:Z \
                 -w /repo/drill $(NODE_IMAGE)

.PHONY: test fmt-check validate helm-lint helm-template history-scrubber answers-check script-tests cluster-git-test tflint scan ministack ministack-down kind-up kind-down kind-status drill-install drill-test drill-build drill-typecheck drill-clean

test: fmt-check validate helm-lint history-scrubber answers-check script-tests ## Static checks (terraform + chart + answers + scripts; helm via Podman)

fmt-check: ## terraform fmt -check
	terraform -chdir=terraform fmt -recursive -check

validate: ## init -backend=false + validate (dev + bootstrap-oidc)
	@set -e; for d in envs/dev bootstrap-oidc; do \
	  echo "== validate $$d =="; \
	  rm -f terraform/$$d/.terraform/terraform.tfstate; \
	  terraform -chdir=terraform/$$d init -backend=false -input=false >/dev/null; \
	  terraform -chdir=terraform/$$d validate; \
	done
	# ^ the rm drops only the cached backend marker (left by a real `make init`),
	#   so this stays credential-free; provider downloads remain cached.

helm-lint: ## helm lint the practice-app chart (inside Podman)
	$(HELM) lint practice-app

helm-template: ## Render the chart with default values (inside Podman)
	$(HELM) template practice-app practice-app

history-scrubber: ## E2E test for the safe git-filter-repo identity wrapper
	bash tests/scrub-git-identity.sh

answers-check: ## Fail if PRACTICE_ANSWERS.html is stale vs scenarios/answers/*.toml
	python3 scripts/gen-answers.py --check
	python3 tests/test_answers.py
	python3 tests/test_gen_answers.py

script-tests: ## Unit tests for the laptop-side scripts in scripts/ (offline, stdlib only)
	python3 -m unittest tests.test_resolve_auto_cidrs

cluster-git-test: ## Prove on kind that Argo CD clones in-cluster git ($0; needs `ministack` first)
	bash tests/cluster-git-argo.sh

tflint: ## Lint if tflint is installed
	@command -v tflint >/dev/null 2>&1 && tflint --chdir=$(TFDIR) --recursive || echo "tflint not installed - skipping"

scan: ## Static security scan if checkov or trivy is installed
	@command -v checkov >/dev/null 2>&1 && checkov -d terraform --quiet \
	 || { command -v trivy >/dev/null 2>&1 && trivy config terraform; } \
	 || echo "checkov/trivy not installed - skipping"

ministack: ## Full terraform plan against a local ministack (Podman) mock AWS
	bash scripts/ministack-test.sh $(ENV)

ministack-down: ## Force-stop any leftover ministack containers
	-podman ps -a --filter name=ministack_ -q | xargs -r podman rm -f

kind-up: ## Create the throwaway kind sandbox cluster ($0, no AWS)
	bash scripts/kind-sandbox.sh up

kind-status: ## Is the kind sandbox up and Ready?
	bash scripts/kind-sandbox.sh status

kind-down: ## Delete the kind sandbox cluster and its kubeconfig
	bash scripts/kind-sandbox.sh down

drill-install: ## npm install for the drill workspaces (inside Podman)
	$(NODE) npm install

drill-typecheck: ## tsc --noEmit across the drill workspaces (inside Podman)
	$(NODE) npm run typecheck

drill-test: ## Unit tests for the drill workspaces (inside Podman)
	$(NODE) npm test

drill-build: ## Build the drill workspaces (inside Podman)
	$(NODE) npm run build

drill-clean: ## Drop the node_modules volume and the empty host mountpoint
	-podman volume rm $(NODE_MODULES)
	-rmdir drill/node_modules
