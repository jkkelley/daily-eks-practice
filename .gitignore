# ---- container-sandbox / ministack skill: mandated entries (never commit) ----
test/
**/.terraform/
*.tfvars
*.tfstate.backup
**/.terraform.lock.hcl

# ---- Terraform ----
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Bootstrap: generated tfvars + the real (local) config. The documented
# scripts/config.example.toml stays committed as the hand-off template.
**/config.auto.tfvars.json
scripts/config.toml

# ---- Lavish review artifacts (local only) ----
.lavish/

# ---- Claude local settings (keep skills/, drop local settings) ----
.claude/settings.local.json

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
.env

# ---- Python ----
__pycache__/
*.pyc

# Run thru notes
notes/
# ---- generated Argo CD manifests (repo URL is user-specific) ----
argocd/generated/

# ---- repo-local kubeconfig (make kubeconfig) ----
.kubeconfig-daily-eks-practice

# ---- kind sandbox kubeconfig (make -f Makefile.test kind-up) ----
.kubeconfig-kind-sandbox

# ---- your personal drill history (never commit; nobody wants to fork it) ----
# Holds a git bundle of your own working tree per session. It is your practice
# record, it is personal, and it survives because it is on your laptop - not
# because it is committed. This entry exists BEFORE anything can create the
# directory, so a save file is never one `git add -A` away from being published.
drill-progress/

# ---- drill GUI (node) ----
drill/**/node_modules/
drill/**/dist/
drill/**/.vite/
drill/**/*.tsbuildinfo

# ---- skill update logs ----
# Written by skill-versioning's skill-update.sh, one per run, naming a local
# dotfiles path. Machine-specific and of no use to anyone else who clones this.
.claude/logs/
